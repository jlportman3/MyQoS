{
  "uid": "lqos-history",
  "title": "LibreQoS Shaper \u2014 History",
  "tags": [
    "libreqos",
    "alamo"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Throughput (Gbps)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15
          },
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "lqos_throughput_gbps{dir=\"down\"}",
          "legendFormat": "down {{shaper}}"
        },
        {
          "refId": "B",
          "expr": "lqos_throughput_gbps{dir=\"up\"}",
          "legendFormat": "up {{shaper}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Packets / sec",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          },
          "unit": "pps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "lqos_throughput_pps{dir=\"down\"}",
          "legendFormat": "down {{shaper}}"
        },
        {
          "refId": "B",
          "expr": "lqos_throughput_pps{dir=\"up\"}",
          "legendFormat": "up {{shaper}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "CPU: softirq-max % / load1 / cores>85%",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 5
          },
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "lqos_cpu_softirq_max_pct{shaper=\"vm406-25g-active\"}",
          "legendFormat": "softirq max %"
        },
        {
          "refId": "B",
          "expr": "lqos_load1{shaper=\"vm406-25g-active\"}",
          "legendFormat": "load1"
        },
        {
          "refId": "C",
          "expr": "lqos_cores_over_85_soft{shaper=\"vm406-25g-active\"}",
          "legendFormat": "cores>85% softirq"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "CAKE drops / sec",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          },
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(lqos_cake_drops_total{dir=\"download\"}[5m])",
          "legendFormat": "down drops/s {{shaper}}"
        },
        {
          "refId": "B",
          "expr": "rate(lqos_cake_drops_total{dir=\"upload\"}[5m])",
          "legendFormat": "up drops/s {{shaper}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "CAKE backlog (bytes)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          },
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "lqos_cake_backlog_bytes{dir=\"download\"}",
          "legendFormat": "down {{shaper}}"
        },
        {
          "refId": "B",
          "expr": "lqos_cake_backlog_bytes{dir=\"upload\"}",
          "legendFormat": "up {{shaper}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Circuits & CAKE qdiscs",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 5
          },
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "lqos_circuits_total{shaper=\"vm406-25g-active\"}",
          "legendFormat": "circuits (ShapedDevices)"
        },
        {
          "refId": "B",
          "expr": "lqos_cake_qdiscs{dir=\"download\"}",
          "legendFormat": "cake qdiscs down"
        }
      ]
    }
  ],
  "links": [
    {
      "title": "Per-customer drill-down \u25b6",
      "type": "link",
      "url": "/d/lqos-customer/libreqos-per-customer",
      "targetBlank": false
    }
  ]
}