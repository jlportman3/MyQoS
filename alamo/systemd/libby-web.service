[Unit]
Description=Libby (local) web chat + RAG backend (FastAPI/SSE)
After=network-online.target lqos-api.service
Wants=network-online.target lqos-api.service

[Service]
Type=simple
WorkingDirectory=/opt/libreqos-mcp
EnvironmentFile=/opt/libreqos-mcp/.litellm_env
Environment=LITELLM_URL=http://10.0.60.48:4000
Environment=LIBBY_MODEL=qwen3.6-35b-a3b
Environment=LQOS_API=http://127.0.0.1:9200
# Gate startup on lqos-api (:9200) actually LISTENING — libby_web discovers its
# tools once at startup, so if it races ahead of lqos-api's socket bind it comes
# up with 0 tools (Libby can't pull live data). Bounded wait so it still starts
# (degraded) if lqos-api never comes up.
ExecStartPre=/bin/sh -c 'for i in $(seq 1 60); do curl -sf http://127.0.0.1:9200/openapi.json >/dev/null 2>&1 && exit 0; sleep 1; done; exit 0'
ExecStart=/opt/libreqos-mcp/venv/bin/uvicorn libby_web:app --host 0.0.0.0 --port 9201 --workers 1
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
